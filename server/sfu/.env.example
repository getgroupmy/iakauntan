# Copy to `.env` and fill in. `.env` is git-ignored — nothing below
# belongs in a commit.

# The same string as the Supabase function secret of the same name.
# `openssl rand -hex 32`
CALL_SFU_SECRET=

# coturn's static-auth-secret, and again the same string as the Supabase
# function secret. A different value from the one above.
CALL_TURN_SECRET=

# This machine's PUBLIC address. Get this wrong and every call connects
# and stays silent, because clients are told to send media to an address
# they cannot reach.
MEDIASOUP_ANNOUNCED_IP=

# The TURN hostname, e.g. call.example.my
TURN_REALM=

# Optional, and worth setting on a small box. Defaults to one worker per
# core, which is four on a 4-core NAS -- more than a handful of calls
# will ever need, and four processes beside DSM on 2 GB of RAM is the
# wrong trade. A call lives entirely inside one worker regardless.
# MEDIASOUP_WORKERS=2
