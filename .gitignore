# Flutter / Dart
app/.dart_tool/
app/.packages
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
*.iml
.idea/
.vscode/

# Secrets — never commit Supabase service keys or MyInvois credentials
.env
.env.*
!.env.example
supabase/.temp/
supabase/.branches/

# graphify knowledge graph
#
# graph.json, GRAPH_REPORT.md and manifest.json are committed on purpose so a
# new checkout starts with a map instead of rebuilding one. The rest is either
# local state or regenerable:
graphify-out/cache/
graphify-out/cost.json
# `graphify update` drops a dated 2.9 MB snapshot beside the live graph on
# every run. Git already keeps the history.
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# Holds the absolute path of the machine the graph was built on.
graphify-out/.graphify_root
# The interpreter the build ran under: another absolute path, another machine.
graphify-out/.graphify_python
# Build intermediates. The pipeline deletes most of these at the end and leaves
# these three behind, which is how they came to be offered for commit.
graphify-out/.graphify_incremental.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_chunk_*.json
graphify-out/memory/
graphify-out/reflections/
# 2.3 MB of generated markup that changes wholesale on every rebuild. Rebuild
# it with `graphify cluster-only .` when you want to click around the graph.
graphify-out/graph.html
#
# The PreToolUse hooks graphify installs hard-code the absolute path of the
# machine they were installed on, so they are per-developer rather than shared.
# Run `graphify claude install --project` after cloning to get your own.
# The query-first guidance itself lives in CLAUDE.md, which is committed.
.claude/settings.json
.claude/settings.local.json

# Vercel: .vercel/output is assembled at deploy time from app/build/web,
# and .vercel/project.json is whatever local link the CLI made.
.vercel/

# Python bytecode from the CI helper scripts
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
app/screenshots/out/
