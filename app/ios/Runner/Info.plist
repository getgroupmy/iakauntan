<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>iAkauntan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>iakauntan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export compliance, answered here rather than in App Store
	     Connect on every upload.

	     false means "uses no NON-EXEMPT encryption". It is not a claim
	     that nothing is encrypted: every call this app makes is over
	     HTTPS. Standard TLS for protecting a connection is exempt, and
	     this app implements no encryption of its own. There is no
	     at-rest encryption, no bundled cipher, and nothing beyond the
	     transport plus the platform's own passkey and push APIs.

	     Without this key, App Store Connect stops each build with the
	     App Encryption Documentation dialog before it can reach a
	     tester, which on an automated release is a build that uploads
	     and then silently waits for somebody to notice. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Required by image_picker. iOS terminates the app outright when a
	     camera or library is opened without one of these, so their
	     absence is a crash rather than a refused permission. -->
	<key>NSCameraUsageDescription</key>
	<string>Photograph a receipt or bill to file it against an expense, and show your camera on a video call.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach a photo of a receipt or bill you have already taken.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Recording a voice note, and speaking on a call.</string>
	<!-- Audio in the background so a call keeps its sound when the
	     screen locks or somebody switches app mid-conversation. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
</dict>
</plist>
