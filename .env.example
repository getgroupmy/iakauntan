# =====================================================================
# iAkauntan :: every value the system reads from its environment
#
# Copy to `.env` for local work. `.env` is gitignored; this file is not,
# so it must never hold a real value — placeholders only.
#
# Nothing here is read by the deployed system directly. Each value has
# one real home, named against it below, and this file exists so that
# the list can be seen in one place:
#
#   Edge Functions → Secrets   the server-side secrets. Never in the
#                              repository, never in a migration, never
#                              in a table, never in the Flutter bundle.
#   GitHub → Actions Secrets   what CI needs to deploy and to call the
#                              scheduled functions.
#   GitHub → Actions Variables what is public and merely configuration.
#   --dart-define              compiled into the client bundle, so only
#                              ever public values.
# =====================================================================

# ---------------------------------------------------------------------
# Client bundle (--dart-define). Everything here is readable by anyone
# who opens the app. That is the design, not an oversight.
# ---------------------------------------------------------------------

# The project URL and the publishable ("anon") key. Public by design:
# row level security is what protects the data, not this key. It is safe
# here for exactly as long as every table has RLS and no SECURITY
# DEFINER function is granted to `anon` without a token check.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_replace_me

# The VAPID public key browsers subscribe to push with. Public by
# design; its private half is a function secret. Leave empty to have the
# app report push as unconfigured, which is better than a wrong key —
# a browser subscribed with one key and pushed to with another drops
# every message silently.
WEB_PUSH_PUBLIC_KEY=

# The one-tap demo logins on the sign-in page, and the password they
# use. `true` ships a working login inside the bundle. Set to false
# before this deployment carries anybody's real ledger, and delete the
# demo users at the same time — see README, "Before real books".
DEMO_MODE=true
DEMO_PASSWORD=replace-me-if-you-seed-your-own-demo-data

# ---------------------------------------------------------------------
# Edge Functions → Secrets. Server-side only. None of these may appear
# in the repository, in a migration, in a table, or in the client.
# ---------------------------------------------------------------------

# Supplied by the platform to every function; listed for completeness.
# The service role key bypasses row level security entirely, which is
# why it exists only here.
SUPABASE_SERVICE_ROLE_KEY=

# What the scheduled workflows present instead of a key with authority.
SCHEDULER_SECRET=

# Outbound email (Resend).
RESEND_API_KEY=
MAIL_FROM=

# Web push. The private half of the pair above.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com

# Android and iOS push.
FCM_SERVICE_ACCOUNT=

# The call server. The SFU's shared secret belongs in a function secret,
# never in the database and never in the bundle.
CALL_SFU_URL=
CALL_SFU_SECRET=
CALL_TURN_SECRET=

# Receipt scanning. Off by default and opted into per company; a
# company's own provider keys live in `org_ocr_credentials`, which is
# service-role-only and never returned to the client.
OCR_GOOGLE_PROJECT=
OCR_GOOGLE_LOCATION=
OCR_GOOGLE_PROCESSOR=

# ---------------------------------------------------------------------
# GitHub → Actions. Secrets unless marked otherwise.
# ---------------------------------------------------------------------

SUPABASE_ACCESS_TOKEN=
# The database password from Supabase → Settings → Database. Without it
# the migrate job reports and applies nothing.
SUPABASE_DB_PASSWORD=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Variables, not secrets: configuration rather than credentials.
SUPABASE_PROJECT_REF=your-project-ref
MIGRATIONS_AUTOPUSH=false
